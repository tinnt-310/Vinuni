<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find vehicle_description)/urdf/fr10_ros2_control.xacro"/>
<xacro:macro name="arm_control_interfaces" params="dynamic_simulation:=false">
<xacro:property name="simulation_gains" value="${xacro.load_yaml('$(find vehicle_description)/config/fr10_simulation_actuators.yaml') if dynamic_simulation else dict()}"/>
<joint name="j1">
            <xacro:fr10_simulated_pid index="${0}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][0]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j2">
            <xacro:fr10_simulated_pid index="${1}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][1]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j3">
            <xacro:fr10_simulated_pid index="${2}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][2]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j4">
            <xacro:fr10_simulated_pid index="${3}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][3]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j5">
            <xacro:fr10_simulated_pid index="${4}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][4]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j6">
            <xacro:fr10_simulated_pid index="${5}" active="${dynamic_simulation}" gains="${simulation_gains}"/>
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][5]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        </xacro:macro>
</robot>
