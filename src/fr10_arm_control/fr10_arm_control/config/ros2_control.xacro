<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="arm_control_interfaces" params="">
<joint name="j1">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][0]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j2">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][1]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j3">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][2]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j4">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][3]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j5">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][4]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="j6">
            <command_interface name="position" />
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][5]}</param></state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        </xacro:macro>
</robot>
