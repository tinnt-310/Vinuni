<?xml version="1.0"?>
<sdf version="1.6">
  <world name="fr10_force_test">
    <gravity>0 0 -9.80665</gravity>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <contact>
              <ode>
                <!-- A finite contact stiffness is required for meaningful
                     closed-loop force regulation in Gazebo Classic. -->
                <kp>10000</kp>
                <kd>100</kd>
                <max_vel>0.02</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Test-only insertable socket.  The visual is the supplied VinFast CCS2
         port, transformed so its mating frame is exactly the model origin and
         mesh +Y (insertion) is charging_tcp +Z.  Four rails and the rear plate
         are deterministic contact proxies; they do not replace the CAD in a
         production collision model.  This fixture is never loaded by
         production worlds. -->
    <model name="fr10_force_insertion_socket">
      <static>true</static>
      <!-- Match the FR10/vehicle charging frame: rpy=(-pi,0,-pi/2).
           The transformed STL extends 93.8 mm below its mating frame, so
           this height places its rear face on the ground (world z=0). -->
      <pose>0.55 0 0.0938 -3.14159265359 0 -1.57079632679</pose>
      <link name="socket">
        <visual name="charging_port_cad_visual">
          <!-- Detailed charging-port/socket mesh supplied under
               vehicle_description/meshes/cong_sac.  The force plate/rails
               below remain deterministic test-only collision proxies. -->
          <pose>0 -0.7675 0.0065 1.57079632679 0 3.14159265359</pose>
          <geometry>
            <mesh>
              <uri>model://cong_sac/meshes/cong_sac.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.10 1</ambient>
            <diffuse>0.08 0.08 0.10 1</diffuse>
          </material>
        </visual>
        <collision name="rear_plate_collision">
          <pose>0 0 0.055 0 0 0</pose>
          <geometry><box><size>0.18 0.20 0.01</size></box></geometry>
          <surface>
            <contact><ode><kp>20000</kp><kd>150</kd><max_vel>0.01</max_vel><min_depth>0.00005</min_depth></ode></contact>
            <friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction>
          </surface>
        </collision>
        <!-- No blue proxy visual: only the supplied CAD is rendered.
             The rear-plate collision remains a test-only force proxy,
             not a CAD socket collision or a certified mating test. -->
        <collision name="left_rail_collision">
          <pose>-0.07 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.12</size></box></geometry>
        </collision>
        <collision name="right_rail_collision">
          <pose>0.07 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.12</size></box></geometry>
        </collision>
        <collision name="lower_rail_collision">
          <pose>0 -0.081 0 0 0 0</pose>
          <geometry><box><size>0.12 0.02 0.12</size></box></geometry>
        </collision>
        <collision name="upper_rail_collision">
          <pose>0 0.081 0 0 0 0</pose>
          <geometry><box><size>0.12 0.02 0.12</size></box></geometry>
        </collision>
      </link>
      <!-- Semantic mating frame: world position [0.55, 0, 0.0938] with the same
           charging-frame orientation as the FR10 tool. -->
      <link name="charging_port_tcp"/>
      <joint name="socket_to_charging_port_tcp" type="fixed">
        <parent>socket</parent>
        <child>charging_port_tcp</child>
      </joint>
    </model>
    <physics name="ode" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>
