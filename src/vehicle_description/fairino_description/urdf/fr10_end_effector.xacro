<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    FR10 charging end effector.

    Confirmed from the stock URDF/STL
      wrist3 visual/collision origin = identity
      tool flange center            = (0, 0, 0.106) m in wrist3_link
      outward flange normal         = +Z of wrist3_link

    Every other mount transform and custom-tool dimension below is an
    illustrative placeholder until replaced by CAD or measured values.
  -->
  <xacro:macro name="fr10_end_effector" params="
      use_gazebo:=false enable_custom_collisions:=true
      flange_xyz:='0 0 0.106' flange_rpy:='0 0 0'
      ft_sensor_xyz:='0 0 0' ft_sensor_rpy:='0 0 0'
      tool_plate_xyz:='0 0 0.030' tool_plate_rpy:='0 0 0'
      d455_xyz:='-0.0475 0 0.012' d455_rpy:='0 -1.57079632679 1.57079632679'
      charging_mount_xyz:='0.060 0 0.012' charging_mount_rpy:='0 0 0'
      charging_connector_xyz:='0 0 0.040' charging_connector_rpy:='0 0 0'
      tool0_xyz:='0 0 0.080' tool0_rpy:='0 0 0'
      ft_sensor_radius:=0.045 ft_sensor_length:=0.030
      tool_plate_size_x:=0.140 tool_plate_size_y:=0.100 tool_plate_size_z:=0.012
      charging_mount_size_x:=0.040 charging_mount_size_y:=0.050 charging_mount_size_z:=0.040
      connector_body_size_x:=0.045 connector_body_size_y:=0.035 connector_body_length:=0.060
      connector_tip_radius:=0.012 connector_tip_length:=0.020">

    <!-- Exact mechanical datum obtained from the FR10 wrist3 STL. -->
    <link name="flange_link">
      <!--
        Gazebo bookkeeping inertia only.  Values are deliberately small but
        remain above sdformat's invalid-inertia tolerance so this datum link
        and the downstream force/torque joint are not discarded.
      -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="wrist3_to_flange" type="fixed">
      <origin xyz="${flange_xyz}" rpy="${flange_rpy}"/>
      <parent link="wrist3_link"/>
      <child link="flange_link"/>
    </joint>

    <!-- Placeholder F/T envelope. The link frame is its flange-side mount face. -->
    <link name="ft_sensor_link">
      <inertial>
        <origin xyz="0 0 ${ft_sensor_length / 2.0}" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${ft_sensor_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${ft_sensor_radius}" length="${ft_sensor_length}"/></geometry>
        <material name="ft_sensor_gray"><color rgba="0.35 0.35 0.35 1"/></material>
      </visual>
      <xacro:if value="${enable_custom_collisions}">
        <collision>
          <origin xyz="0 0 ${ft_sensor_length / 2.0}" rpy="0 0 0"/>
          <geometry><cylinder radius="${ft_sensor_radius}" length="${ft_sensor_length}"/></geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="flange_to_ft_sensor" type="fixed">
      <origin xyz="${ft_sensor_xyz}" rpy="${ft_sensor_rpy}"/>
      <parent link="flange_link"/>
      <child link="ft_sensor_link"/>
    </joint>

    <!-- Placeholder tool plate; frame is its sensor-side mounting plane. -->
    <link name="tool_plate_link">
      <inertial>
        <origin xyz="0 0 ${tool_plate_size_z / 2.0}" rpy="0 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${tool_plate_size_z / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${tool_plate_size_x} ${tool_plate_size_y} ${tool_plate_size_z}"/></geometry>
        <material name="tool_plate_gray"><color rgba="0.55 0.55 0.55 1"/></material>
      </visual>
      <xacro:if value="${enable_custom_collisions}">
        <collision>
          <origin xyz="0 0 ${tool_plate_size_z / 2.0}" rpy="0 0 0"/>
          <geometry><box size="${tool_plate_size_x} ${tool_plate_size_y} ${tool_plate_size_z}"/></geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="ft_sensor_to_tool_plate" type="fixed">
      <origin xyz="${tool_plate_xyz}" rpy="${tool_plate_rpy}"/>
      <parent link="ft_sensor_link"/>
      <child link="tool_plate_link"/>
    </joint>

    <!-- Official D455 body mesh and nominal RealSense optical extrinsics. -->
    <link name="d455_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.072"/>
        <inertia ixx="0.003881243" ixy="0" ixz="0" iyy="0.000498940" iyz="0" izz="0.003879257"/>
      </inertial>
      <visual>
        <origin xyz="0.00465 -0.0475 0" rpy="1.57079632679 0 1.57079632679"/>
        <geometry>
          <mesh filename="package://realsense2_description/meshes/d455.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <xacro:if value="${enable_custom_collisions}">
        <collision>
          <origin xyz="-0.00845 -0.0475 0" rpy="0 0 0"/>
          <geometry><box size="0.026 0.124 0.029"/></geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="tool_plate_to_d455" type="fixed">
      <origin xyz="${d455_xyz}" rpy="${d455_rpy}"/>
      <parent link="tool_plate_link"/>
      <child link="d455_link"/>
    </joint>

    <link name="d455_depth_optical_frame"/>
    <joint name="d455_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
      <parent link="d455_link"/>
      <child link="d455_depth_optical_frame"/>
    </joint>
    <link name="d455_color_optical_frame"/>
    <joint name="d455_color_optical_joint" type="fixed">
      <origin xyz="0 -0.059 0" rpy="-1.57079632679 0 -1.57079632679"/>
      <parent link="d455_link"/>
      <child link="d455_color_optical_frame"/>
    </joint>

    <!-- Placeholder offset bracket, intentionally separate from the plug. -->
    <link name="charging_connector_mount_link">
      <inertial>
        <origin xyz="0 0 ${charging_mount_size_z / 2.0}" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${charging_mount_size_z / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${charging_mount_size_x} ${charging_mount_size_y} ${charging_mount_size_z}"/></geometry>
        <material name="mount_dark"><color rgba="0.18 0.18 0.20 1"/></material>
      </visual>
      <xacro:if value="${enable_custom_collisions}">
        <collision>
          <origin xyz="0 0 ${charging_mount_size_z / 2.0}" rpy="0 0 0"/>
          <geometry><box size="${charging_mount_size_x} ${charging_mount_size_y} ${charging_mount_size_z}"/></geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="tool_plate_to_charging_mount" type="fixed">
      <origin xyz="${charging_mount_xyz}" rpy="${charging_mount_rpy}"/>
      <parent link="tool_plate_link"/>
      <child link="charging_connector_mount_link"/>
    </joint>

    <!-- Placeholder plug with rectangular body and cylindrical nose. -->
    <link name="charging_connector_link">
      <inertial>
        <origin xyz="0 0 ${connector_body_length / 2.0}" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${connector_body_length / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${connector_body_size_x} ${connector_body_size_y} ${connector_body_length}"/></geometry>
        <material name="connector_orange"><color rgba="0.9 0.35 0.05 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 ${connector_body_length + connector_tip_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${connector_tip_radius}" length="${connector_tip_length}"/></geometry>
        <material name="connector_metal"><color rgba="0.7 0.72 0.75 1"/></material>
      </visual>
      <xacro:if value="${enable_custom_collisions}">
        <collision>
          <origin xyz="0 0 ${connector_body_length / 2.0}" rpy="0 0 0"/>
          <geometry><box size="${connector_body_size_x} ${connector_body_size_y} ${connector_body_length}"/></geometry>
        </collision>
        <collision>
          <origin xyz="0 0 ${connector_body_length + connector_tip_length / 2.0}" rpy="0 0 0"/>
          <geometry><cylinder radius="${connector_tip_radius}" length="${connector_tip_length}"/></geometry>
        </collision>
      </xacro:if>
    </link>
    <joint name="charging_mount_to_connector" type="fixed">
      <origin xyz="${charging_connector_xyz}" rpy="${charging_connector_rpy}"/>
      <parent link="charging_connector_mount_link"/>
      <child link="charging_connector_link"/>
    </joint>

    <link name="tool0"/>
    <joint name="charging_connector_to_tool0" type="fixed">
      <origin xyz="${tool0_xyz}" rpy="${tool0_rpy}"/>
      <parent link="charging_connector_link"/>
      <child link="tool0"/>
    </joint>

    <!-- Preserve the measuring joint so Gazebo Classic can report joint wrench. -->
    <gazebo reference="flange_to_ft_sensor">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <provideFeedback>true</provideFeedback>
    </gazebo>

    <xacro:if value="${use_gazebo}">
      <gazebo>
        <plugin name="fr10_ft_sensor" filename="libgazebo_ros_ft_sensor.so">
          <ros>
            <namespace>/ft_sensor</namespace>
            <remapping>wrench:=wrench</remapping>
          </ros>
          <update_rate>200</update_rate>
          <joint_name>flange_to_ft_sensor</joint_name>
          <gaussian_noise>0.0</gaussian_noise>
        </plugin>
      </gazebo>

      <gazebo reference="d455_link">
        <sensor name="d455" type="depth">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.50</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <depth_camera/>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <plugin name="d455_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/d455</namespace>
              <remapping>camera/image_raw:=color/image_raw</remapping>
              <remapping>camera/camera_info:=color/camera_info</remapping>
              <remapping>camera/depth/image_raw:=depth/image_raw</remapping>
              <remapping>camera/depth/camera_info:=depth/camera_info</remapping>
              <remapping>camera/points:=depth/color/points</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>d455_color_optical_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>10.0</max_depth>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
