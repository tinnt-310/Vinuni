<?xml version="1.0"?>
<robot name="complete_visual">
  <group name="fairino10_v6_group">
    <chain base_link="fr10_base_link" tip_link="charging_tcp"/>
  </group>
  <group_state name="home" group="fairino10_v6_group">
    <joint name="j1" value="0"/>
    <joint name="j2" value="-1.5707963267948966"/>
    <joint name="j3" value="1.5707963267948966"/>
    <joint name="j4" value="-1.5707963267948966"/>
    <joint name="j5" value="-1.5707963267948966"/>
    <joint name="j6" value="0"/>
  </group_state>
  <!-- Measured home-state contacts of adjacent arm links (same exclusions as
       the vendor FR10 SRDF) and rigid wrist fixture parts. Keep every
       unlisted arm, vehicle and world collision active. Evidence:
       docs/ode_debug/p3_mounted_collision_pairs_20260928_{1,3,4,8}/runtime.log. -->
  <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="fr10_base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="camera_rear_mount" link2="camera_support_right" reason="Fixed"/>
  <disable_collisions link1="camera_support_left" link2="wrist_mount_backplate" reason="Fixed"/>
  <disable_collisions link1="charger_cradle_left" link2="charger_rear_mount" reason="Fixed"/>
  <disable_collisions link1="charger_cradle_left" link2="charging_connector_link" reason="Fixed"/>
  <disable_collisions link1="charger_cradle_right" link2="charging_connector_link" reason="Fixed"/>
  <disable_collisions link1="charger_rear_mount" link2="charging_connector_link" reason="Fixed"/>
  <disable_collisions link1="charger_support_left" link2="wrist_mount_backplate" reason="Fixed"/>
  <disable_collisions link1="charger_support_right" link2="wrist_mount_backplate" reason="Fixed"/>
  <disable_collisions link1="wrist3_link" link2="wrist_mount_backplate" reason="Fixed"/>
  <disable_collisions link1="charger_cradle_right" link2="charger_rear_mount" reason="Fixed"/>
  <disable_collisions link1="charger_rear_mount" link2="charger_support_right" reason="Fixed"/>
  <disable_collisions link1="charger_support_left" link2="charging_connector_link" reason="Fixed"/>
  <disable_collisions link1="charger_support_right" link2="charging_connector_link" reason="Fixed"/>
  <disable_collisions link1="camera_rear_mount" link2="camera_support_left" reason="Fixed"/>
  <disable_collisions link1="camera_support_right" link2="wrist_mount_backplate" reason="Fixed"/>
  <disable_collisions link1="charger_rear_mount" link2="charger_support_left" reason="Fixed"/>
</robot>
