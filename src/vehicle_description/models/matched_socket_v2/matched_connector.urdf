<robot name="matched_charging_tool">
  <link name="charging_connector_link">
    <visual>
      <geometry>
        <mesh filename="package://vehicle_description/models/matched_socket_v2/body.stl" />
      </geometry>
      <material name="matched_tool_dark">
        <color rgba=".14 .16 .18 1" />
      </material>
    </visual>
    <collision name="protected_rear_body">
      <origin xyz="-1.0356307e-06 0.0 -0.02125" />
      <geometry>
        <box size="0.11296203 0.135 0.082499996" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2.8" />
      <origin xyz="-0.00044966809218749404 -0.00045383127871900797 -0.017045563086867332" />
      <inertia ixx="0.005840625177323829" iyy="0.004565556217808651" izz="0.007229931716401507" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <gazebo reference="charging_connector_link">
    <mu1>.20</mu1>
    <mu2>.20</mu2>
    <kp>${matched_ode_contact['stiffness_n_m']}</kp>
    <kd>${matched_ode_contact['damping_n_s_m']}</kd>
    <maxVel>${matched_ode_contact['max_correcting_velocity_m_s']}</maxVel>
    <minDepth>0</minDepth>
  </gazebo>
