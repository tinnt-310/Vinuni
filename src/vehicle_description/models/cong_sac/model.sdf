<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="tram_sac_VF">
    <static>true</static>
    <link name="body_link">
      <visual name="visual_cong_sac">
        <pose>0 0.005 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://cong_sac/meshes/cong_sac.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Black</name>
          </script>
        </material>
      </visual>

      <collision name="collision_cong_sac">
        <pose>0 0.005 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://cong_sac/meshes/cong_sac.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
    <!-- Exact socket mating frame derived from the supplied STL bounds.
         TCP +Z follows CAD +Y into the port; TCP +Y follows CAD +Z. -->
    <link name="charging_port_tcp">
      <pose>0 -0.0015 0.7675 1.57079632679 0 3.14159265359</pose>
    </link>
    <joint name="body_to_charging_port_tcp" type="fixed">
      <parent>body_link</parent>
      <child>charging_port_tcp</child>
    </joint>
  </model>
</sdf>
