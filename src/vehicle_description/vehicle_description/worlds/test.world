<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='default'>
    <!-- === MẶT TRỜI VÀ ÁNH SÁNG === -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -25 20 0 0.5 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- === MẶT ĐƯỜNG NHỰA === -->
    <model name='custom_asphalt_plane'>
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <script>
              <uri>model://asphalt_plane/materials/scripts</uri>
              <uri>model://asphalt_plane/materials/textures</uri>
              <name>vrc/asphalt</name>
            </script>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === DÃY A (HÀNG TRÊN) === -->
    
    <include><name>slot_a1</name><uri>model://parking_slot</uri><pose>-10 8 0 0 0 1.57</pose></include>
    <model name='ev_charging_port_0'>
      <static>1</static>
      <link name='car_body'><pose>0 0 0 0 0 0</pose>
        <visual name='car_body_visual'><geometry><mesh><uri>model://VF9/meshes/VF9.dae</uri><scale>1 1 1</scale></mesh></geometry></visual>
        <collision name='car_body_collision'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>5.0 2.0 1.8</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      </link>
      <link name='charging_port'><pose>0 0 0 0 0 0</pose>
        <visual name='charging_port_visual'><geometry><mesh><uri>model://VF9/meshes/ccs2.dae</uri><scale>1 1 1</scale></mesh></geometry></visual>
        <collision name='charging_port_collision'><geometry><mesh><uri>model://VF9/meshes/ccs2.dae</uri><scale>1 1 1</scale></mesh></geometry></collision>
      </link>
      <pose>-9.8 7.36 0 0 0 1.57</pose>
    </model>


    <!-- Ô A2: Xe VF3 (Đã sửa từ electric_car sang VF3_0) -->
    <include><name>slot_a2</name><uri>model://parking_slot</uri><pose>-5 8 0 0 0 1.57</pose></include>
    <model name='VF3_0'>
      <static>1</static>
      <link name='vf3_link'>
        <pose>0 0 0 0 0 0</pose>
        <visual name='vf3_body_visual'>
          <geometry><mesh><uri>model://VF3/meshes/VF3.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
        <visual name='ccs2_port_visual'>
          <geometry><mesh><uri>model://VF3/meshes/ccs2.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name='car_body_collision'><pose>0 0 0.8 0 0 0</pose><geometry><box><size>4.3 1.76 1.6</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <collision name='ccs2_port_collision'>
          <geometry><mesh><uri>model://VF3/meshes/ccs2.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>
      </link>
      <pose>-4.87 7.8 0 0 0 1.57</pose>
    </model>

    <!-- Ô A3: Xe Electric Car -->
    <include><name>slot_a3</name><uri>model://parking_slot</uri><pose>0 8 0 0 0 1.57</pose></include>
