    <!-- === CỔNG VÀ GỜ GIẢM TỐC === -->
    <model name='parking_gate'>
      <static>true</static>
      <link name='gate_pillar_left'>
        <pose>-20 4 1.5 0 0 0</pose>
        <collision name='c'><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
