    <!-- === CỘT BÊ TÔNG GIỮA CÁC Ô ĐỖ === -->
    <model name='concrete_pillars'>
      <static>true</static>
      <link name='pillar_a1'><pose>-7.8 8 1.5 0 0 0</pose>
        <collision name='c'><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name='v'><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
