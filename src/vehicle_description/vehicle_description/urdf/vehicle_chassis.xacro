<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Parametric closed chassis. Identical visual/collision, no anisotropic mesh scaling. -->
  <xacro:macro name="frame_box" params="xyz sx sy sz">
    <visual><origin xyz="${xyz}"/><geometry><box size="${sx} ${sy} ${sz}"/></geometry><material name="white"/></visual>
    <collision><origin xyz="${xyz}"/><geometry><box size="${sx} ${sy} ${sz}"/></geometry></collision>
  </xacro:macro>
  <xacro:macro name="vehicle_chassis" params="">
    <xacro:property name="deck_bottom" value="${steering_axis_height}"/>
    <xacro:property name="deck_top" value="${deck_bottom+vehicle['deck_thickness']}"/>
    <xacro:property name="roof_bottom" value="${roof_z-vehicle['roof_thickness']}"/>
    <xacro:property name="pw" value="${vehicle['frame_post_width']}"/>
    <link name="base_link">
      <!-- Retain former assumed chassis mass; use new envelope for inertia. -->
      <xacro:inertial_box mass="150" x="${chassis_length}" y="${chassis_width}" z="${roof_z-deck_bottom}">
        <origin xyz="${chassis_center_x} 0 ${(roof_z+deck_bottom)/2}"/>
      </xacro:inertial_box>
      <xacro:frame_box xyz="${chassis_center_x} 0 ${(deck_bottom+deck_top)/2}" sx="${chassis_length}" sy="${chassis_width}" sz="${vehicle['deck_thickness']}"/>
      <xacro:frame_box xyz="${chassis_center_x} 0 ${(roof_bottom+roof_z)/2}" sx="${chassis_length}" sy="${chassis_width}" sz="${vehicle['roof_thickness']}"/>
      <xacro:frame_box xyz="${chassis_center_x+(chassis_length-pw)/2} ${(chassis_width-pw)/2} ${(deck_top+roof_bottom)/2}" sx="${pw}" sy="${pw}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x+(chassis_length-pw)/2} ${-(chassis_width-pw)/2} ${(deck_top+roof_bottom)/2}" sx="${pw}" sy="${pw}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x-(chassis_length-pw)/2} ${(chassis_width-pw)/2} ${(deck_top+roof_bottom)/2}" sx="${pw}" sy="${pw}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x-(chassis_length-pw)/2} ${-(chassis_width-pw)/2} ${(deck_top+roof_bottom)/2}" sx="${pw}" sy="${pw}" sz="${roof_bottom-deck_top}"/>
      <!-- Four external enclosure panels, matching visual and collision. -->
      <xacro:property name="panel" value="${vehicle['body_panel_thickness']}"/>
      <xacro:frame_box xyz="${chassis_center_x+(chassis_length-panel)/2} 0 ${(deck_top+roof_bottom)/2}" sx="${panel}" sy="${chassis_width}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x-(chassis_length-panel)/2} 0 ${(deck_top+roof_bottom)/2}" sx="${panel}" sy="${chassis_width}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x} ${(chassis_width-panel)/2} ${(deck_top+roof_bottom)/2}" sx="${chassis_length-2*panel}" sy="${panel}" sz="${roof_bottom-deck_top}"/>
      <xacro:frame_box xyz="${chassis_center_x} ${-(chassis_width-panel)/2} ${(deck_top+roof_bottom)/2}" sx="${chassis_length-2*panel}" sy="${panel}" sz="${roof_bottom-deck_top}"/>
    </link>
    <link name="roof_frame"/>
    <joint name="base_to_roof" type="fixed"><parent link="base_link"/><child link="roof_frame"/><origin xyz="${chassis_center_x} 0 ${roof_z}"/></joint>
  </xacro:macro>
</robot>
