<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_arm" default="true"/>
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="vehicle_dimensions.xacro"/>
  <xacro:include filename="vehicle_chassis.xacro"/>
  <xacro:include filename="swerve_module.xacro"/>
  <xacro:include filename="thanxe_new.gazebo"/>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0"/></joint>
  <xacro:vehicle_chassis/>
  <xacro:swerve_module index="1" x="${wheelbase/2}" y="${track_width/2}"/>
  <xacro:swerve_module index="2" x="${wheelbase/2}" y="${-track_width/2}"/>
  <xacro:swerve_module index="3" x="${-wheelbase/2}" y="${track_width/2}"/>
  <xacro:swerve_module index="4" x="${-wheelbase/2}" y="${-track_width/2}"/>
</robot>
