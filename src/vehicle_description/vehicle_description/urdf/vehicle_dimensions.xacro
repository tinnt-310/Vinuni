<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="vehicle" value="${xacro.load_yaml('$(find vehicle_description)/config/vehicle_geometry.yaml')['vehicle']}"/>
  <xacro:property name="wheelbase" value="${vehicle['wheelbase']}"/>
  <xacro:property name="track_width" value="${vehicle['track_width']}"/>
  <xacro:property name="steering_envelope_radius" value="${sqrt(vehicle['wheel_radius']**2+(vehicle['wheel_width']/2)**2)+vehicle['steering_envelope_margin']}"/>
  <xacro:property name="steering_axis_height" value="${vehicle['wheel_radius']+vehicle['wheel_axle_drop']}"/>
  <xacro:property name="chassis_length" value="${wheelbase+2*(steering_envelope_radius+vehicle['frame_edge_margin'])}"/>
  <xacro:property name="chassis_width" value="${track_width+2*(steering_envelope_radius+vehicle['frame_edge_margin'])}"/>
  <xacro:property name="chassis_center_x" value="${vehicle['chassis_center_x']}"/>
  <xacro:property name="roof_z" value="${vehicle['roof_top_height']}"/>
  <xacro:property name="robot_x" value="${chassis_center_x}"/>
  <xacro:property name="lidar_x" value="${(chassis_center_x+chassis_length/2+robot_x)/2}"/>
</robot>
