<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr10_vehicle_adapter">
  <!-- Only rename the vendor root to avoid the vehicle base_link name.
       All six joints, inertias, visuals and collisions come from the original. -->
  <xacro:arg name="fr10_root_link" default="fr10_base_link"/>
  <xacro:include filename="$(find fairino_description)/urdf/fairino10_v6.urdf"/>
</robot>
