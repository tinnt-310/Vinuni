<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="complete_visual">
    <xacro:include filename="thanxe_new.xacro" />
    <xacro:include filename="inertial_macros.xacro" />
    <xacro:if value="$(arg enable_arm)">
    <xacro:include filename="fr10_arm.urdf"/>
    <link name="robot_base"/>
    <joint name="roof_to_robot_base" type="fixed">
      <parent link="roof_frame"/><child link="robot_base"/>
      <origin xyz="${robot_x-chassis_center_x} 0 0" rpy="0 0 ${pi}"/>
    </joint>
    <joint name="base_to_fr10" type="fixed"><parent link="robot_base"/><child link="fr10_base_link"/></joint>
    <xacro:include filename="fr10_wrist.xacro"/>
    <xacro:fr10_wrist/>
    </xacro:if>

    <xacro:include filename="body_sensors.xacro"/>
    <xacro:body_sensors/>




</robot>
