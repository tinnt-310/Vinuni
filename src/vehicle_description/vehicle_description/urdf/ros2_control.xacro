<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="Revolute1_to_base_link">
            <command_interface name="position">
                <param name="min">-3.14</param>
                <param name="max">3.14</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute2_to_base_link">
            <command_interface name="position">
                <param name="min">-3.14</param>
                <param name="max">3.14</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute3_to_base_link">
            <command_interface name="position">
                <param name="min">-3.14</param>
                <param name="max">3.14</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute4_to_base_link">
            <command_interface name="position">
                <param name="min">-3.14</param>
                <param name="max">3.14</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="Wheel1_to_Revolute1">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Wheel2_to_Revolute2">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Wheel3_to_Revolute3">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="Wheel4_to_Revolute4">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <xacro:if value="$(arg enable_arm)">
        <joint name="j1">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][0]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="j2">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][1]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="j3">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][2]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="j4">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][3]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="j5">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][4]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="j6">
            <command_interface name="position"/>
            <state_interface name="position"><param name="initial_value">${vehicle['arm_home'][5]}</param></state_interface>
            <state_interface name="velocity"/>
        </joint>
        </xacro:if>
    </ros2_control>

</robot>
