<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro"/>
  <xacro:macro name="body_sensors" params="">
    <!-- D455 body outside the front skin. Optical height remains 0.40m
         from nominal ground; the camera is supported by a descending L bracket. -->
    <xacro:property name="front_x" value="${chassis_center_x+chassis_length/2}"/>
    <xacro:property name="camera_x" value="${front_x+vehicle['d455_rear_gap']+0.013}"/>
    <xacro:property name="camera_z" value="${vehicle['d455_optical_height']}"/>
    <xacro:property name="bracket_top" value="${steering_axis_height+vehicle['deck_thickness']+0.020}"/>
    <link name="d455_mount_frame"/>
    <joint name="base_to_d455_mount" type="fixed"><parent link="base_link"/><child link="d455_mount_frame"/><origin xyz="${camera_x} 0 ${camera_z}"/></joint>
    <link name="d455_front_bracket">
      <xacro:inertial_box mass="0.10" x="0.006" y="0.04" z="${bracket_top-camera_z+0.0195}"><origin xyz="0 0 0"/></xacro:inertial_box>
      <xacro:frame_box xyz="0 0 0" sx="0.006" sy="0.04" sz="${bracket_top-camera_z+0.0195}"/>
      <xacro:frame_box xyz="${(camera_x-front_x-0.003)/2} 0 ${-(bracket_top-camera_z+0.0195)/2+0.0025}" sx="${camera_x-front_x-0.003}" sy="0.04" sz="0.005"/>
    </link>
    <joint name="base_to_d455_bracket" type="fixed"><parent link="base_link"/><child link="d455_front_bracket"/><origin xyz="${front_x+0.003} 0 ${(bracket_top+camera_z-0.0195)/2}"/></joint>
    <!-- Official macro: body centre=(-.00835,-.0475,0) in d455_link.
         Optical frames retain factory nominal stereo offsets, Z=.400. -->
    <xacro:sensor_d455 parent="d455_mount_frame" name="d455" use_nominal_extrinsics="true">
      <origin xyz="-0.0028 0 -0.0145" rpy="0 0 0"/>
    </xacro:sensor_d455>
    <gazebo reference="d455_link">
      <sensor type="depth" name="body_camera_sensor">
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera><horizontal_fov>1.518</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        <plugin name="d455_simulator" filename="libgazebo_ros_camera.so"><ros><namespace>/body_camera</namespace></ros><camera_name>d455</camera_name><frame_name>d455_depth_optical_frame</frame_name><min_depth>0.1</min_depth><max_depth>20</max_depth></plugin>
      </sensor>
    </gazebo>
    <link name="lidar_mount_frame">
      <visual><origin xyz="0 0 ${vehicle['lidar_mount_height']/2}"/><geometry><cylinder radius="0.025" length="${vehicle['lidar_mount_height']}"/></geometry><material name="white"/></visual>
      <collision><origin xyz="0 0 ${vehicle['lidar_mount_height']/2}"/><geometry><cylinder radius="0.025" length="${vehicle['lidar_mount_height']}"/></geometry></collision>
      <xacro:inertial_cylinder mass="0.05" radius="0.025" length="${vehicle['lidar_mount_height']}"><origin xyz="0 0 ${vehicle['lidar_mount_height']/2}"/></xacro:inertial_cylinder>
    </link>
    <joint name="roof_to_lidar_mount" type="fixed"><parent link="roof_frame"/><child link="lidar_mount_frame"/><origin xyz="${lidar_x-chassis_center_x} 0 0"/></joint>
    <!-- Explicit G2 size approximation pending a verified public G2 CAD asset.
         No other LiDAR's mesh is substituted or relabelled as G2. -->
    <link name="lidar_link">
      <visual><geometry><cylinder radius="${vehicle['lidar_radius']}" length="${vehicle['lidar_height']}"/></geometry><material name="black"/></visual>
      <collision><geometry><cylinder radius="${vehicle['lidar_radius']}" length="${vehicle['lidar_height']}"/></geometry></collision>
      <xacro:inertial_cylinder mass="0.185" radius="${vehicle['lidar_radius']}" length="${vehicle['lidar_height']}"><origin xyz="0 0 0"/></xacro:inertial_cylinder>
    </link>
    <joint name="lidar_mount_to_body" type="fixed"><parent link="lidar_mount_frame"/><child link="lidar_link"/><origin xyz="0 0 ${vehicle['lidar_mount_height']+vehicle['lidar_height']/2}"/></joint>
    <link name="laser_frame"/>
    <joint name="lidar_scan_joint" type="fixed"><parent link="lidar_link"/><child link="laser_frame"/><origin xyz="0 0 ${vehicle['lidar_scan_height_from_bottom']-vehicle['lidar_height']/2}"/></joint>
    <gazebo reference="laser_frame">
      <sensor type="ray" name="laser"><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <ray><scan><horizontal><samples>500</samples><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range></ray>
        <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_frame</frame_name></plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
